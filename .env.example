# Copy to .env for local development. On the Sige1 deployment these same
# values live in /etc/depdash/clickup.env and are loaded from there instead
# (see README.md "Deployment" section) - server.js checks both locations.

CLICKUP_API_TOKEN=pk_xxxxxxxxx
CLICKUP_TEAM_ID=2565206
CLICKUP_WIP_LIST_ID=25523553

# Notification targets for "Report Problem" comments
CLICKUP_NOTIFY_USER_IDS=4669371,93847871

# Google Drive service account key file (read-only access to the two folders below)
GOOGLE_APPLICATION_CREDENTIALS=/etc/depdash/drive-credentials.json
DRIVE_JOB_SHEETS_FOLDER_ID=1X71HbOoQw6hpgA6xirrfB81VIypA_1H4
DRIVE_CUTLIST_DRAWING_FOLDER_ID=1ffYzLYZII5S4BL_9U8XFPNB7G6l71RFc

# Local server
PORT=3000
NODE_ENV=production

# Admin page (HTTP Basic Auth)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Polling / refresh intervals (ms)
CLICKUP_POLL_INTERVAL_MS=30000
DRIVE_INDEX_INTERVAL_MS=300000

# Path to local SQLite DB
DEPDASH_DB_PATH=./data/depdash.sqlite

# Config file overrides (defaults to ./config/*.json; on-device these point at /etc/depdash/*.json)
DEPDASH_SCHEDULE_CONFIG=./config/schedule.json
DEPDASH_ROUTING_CONFIG=./config/routing.json
DEPDASH_DASHBOARD_CONFIG=./config/dashboard.json
