[Unit]
Description=DepDash Kiosk Browser
After=depdash-backend.service
Requires=depdash-backend.service

[Service]
Type=simple
User=root
Environment=HOME=/root
ExecStartPre=/bin/sleep 5
ExecStart=/usr/bin/startx /opt/depdash/deploy/kiosk-start.sh -- :0 vt1 -nocursor
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
